Table datasets {
  id int [pk]
  name varchar [not null]
  task varchar [not null]
  size int [not null]
}

Table models {
  id int [pk]
  name varchar [not null]
  version varchar [not null]
}

Table experiments {
  id int [pk]
  dataset_id int [not null]
  model_id int [not null]
  accuracy float [not null]
  status varchar [not null]
}

Ref: experiments.dataset_id > datasets.id
Ref: experiments.model_id > models.id
